#!/usr/bin/env python3
"""Apply the tested Chromium renderer settings as the desktop user."""
from datetime import datetime
import os
from pathlib import Path
import shutil
import sys
import tempfile

FLAGS = [
    "--render-node-override=/dev/dri/by-path/pci-0000:00:02.0-render",
    "--use-gl=angle",
    "--use-angle=gl",
    "--disable-accelerated-video-decode",
]


def main():
    if os.geteuid() == 0:
        sys.exit("Run as the Omarchy desktop user, without sudo")
    if Path("/sys/class/dmi/id/product_name").read_text().strip() != "MacBookPro13,3":
        sys.exit("Unsupported model")
    p = Path.home() / ".config/chromium-flags.conf"
    if p.is_symlink():
        sys.exit("Refusing symlinked Chromium flags")
    old = p.read_text() if p.exists() else ""
    keys = tuple(f.split("=")[0] for f in FLAGS) + ("--disable-gpu",)
    kept = [line for line in old.splitlines() if line.strip().split("=")[0] not in keys]
    new = "\n".join(kept + FLAGS) + "\n"
    if new == old:
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    mode = (p.stat().st_mode & 0o777) if p.exists() else 0o644
    if p.exists():
        backup = p.with_name(p.name + ".before-macbook-video-" + datetime.now().strftime("%Y%m%d-%H%M%S"))
        shutil.copy2(p, backup)
    fd, temporary = tempfile.mkstemp(prefix=".chromium-flags-", dir=p.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(new)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, p)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("Chromium configured: Intel/OpenGL rendering; software video decoding")


if __name__ == "__main__":
    main()
