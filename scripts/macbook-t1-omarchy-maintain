write_file /etc/limine-entry-tool.d/macbook13-stability.conf 0644 root root <<'EOF'
# The integrated GPU owns the internal panel.  Keeping amdgpu out of normal
# boots avoids the Polaris reset callback that hangs S3 resume on this model.
# This machine exposes the internal PCH codec first and the unused Radeon HDMI
# codec second; do not let the latter bind and retain Radeon power during sleep.
# Deep sleep strands both Alpine Ridge USB controllers, so make s2idle the safe
# kernel default as well as the systemd sleep policy.
# Leave PCIe services native so Alpine Ridge can run its full resume path.
# The hand-written Safe Graphics and Console entries remain Radeon-capable.
KERNEL_CMDLINE[default]+=" module_blacklist=amdgpu snd_hda_intel.enable=1,0 mem_sleep_default=s2idle"
EOF

write_file /etc/mkinitcpio.conf.d/zz-macbook-t1-early-kms.conf 0644 root root <<'EOF'
# Load the Intel display driver before Plymouth.  The Radeon is deliberately
# kept out of the normal boot because its S3 noirq reset hangs this model.
MODULES+=(i915)
EOF
if (( write_changed )); then
  mark_uki_rebuild_pending "switched early graphics from Radeon to Intel"
fi

# Hibernation image restore resets this T1 MacBook before userspace on both
# supported kernels.  Keep the stock mkinitcpio resume hook for normal boot
# compatibility, but remove the one-off diagnostic hook used during analysis.
removed_resume_artifact=0
for resume_artifact in \
  /etc/initcpio/hooks/macbook-t1-resume \
  /etc/initcpio/install/macbook-t1-resume \
  /etc/mkinitcpio.conf.d/zz-macbook-t1-resume.conf; do
  if [[ -e "$resume_artifact" || -L "$resume_artifact" ]]; then
    rm -f -- "$resume_artifact"
    echo "removed: $resume_artifact"
    removed_resume_artifact=1
  fi
done
if (( removed_resume_artifact )); then
  mark_uki_rebuild_pending "removed diagnostic hibernation resume hook"
fi

write_file /usr/local/sbin/macbook-t1-radeon-off 0755 root root <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ $EUID == 0 ]] || exit 1
[[ $(cat /sys/class/dmi/id/product_name) == MacBookPro13,3 ]] || exit 0
desktop_user=$(awk -F= '$1 == "OMARCHY_USER" { print $2; exit }' /etc/macbook-t1-omarchy.conf 2>/dev/null || true)
[[ -n $desktop_user ]] || desktop_user=$(getent passwd 1000 | cut -d: -f1)
desktop_home=$(getent passwd "$desktop_user" | cut -d: -f6)
config=$desktop_home/.config/hypr/hyprland.lua
gmux=/sys/kernel/debug/apple_gmux
intel_panel_connected() {
  local connector card device name
  for connector in /sys/class/drm/card*-eDP-*/status /sys/class/drm/card*-LVDS-*/status; do
    [[ -e $connector ]] || continue
    name=$(basename "${connector%/status}")
    card=/sys/class/drm/${name%%-*}
    device=$(basename "$(readlink -f "$card/device")")
    [[ $device == 0000:00:02.0 ]] || continue
    [[ $(cat "$connector") == connected ]] && return 0
  done
  return 1
}
for _ in $(seq 1 60); do
  if intel_panel_connected && pgrep -x Hyprland >/dev/null; then break; fi
  sleep 1
done
intel_panel_connected || { echo 'Intel does not own a connected internal panel' >&2; exit 1; }
grep -Fq 'hl.env("AQ_DRM_DEVICES", "/dev/dri/intel-igpu")' "$config" || {
  echo 'Hyprland is not pinned to Intel' >&2; exit 1;
}
if [[ -e /sys/bus/pci/devices/0000:01:00.0/driver ]] || [[ -d /sys/module/amdgpu ]]; then
  echo 'amdgpu is bound or loaded; refusing to cut Radeon power' >&2
  exit 1
fi

# The HDMI function can bind independently even though amdgpu is blacklisted.
# The managed kernel command line disables its second snd_hda_intel instance
# before userspace can open it. Never unbind it here: snd_card_free can block
# indefinitely once PipeWire has observed the card.
radeon_audio=/sys/bus/pci/devices/0000:01:00.1
[[ ! -e $radeon_audio/driver ]] || {
  echo 'Radeon HDMI audio is bound; refusing to cut Radeon power (check snd_hda_intel.enable=1,0)' >&2
  exit 1
}
[[ -w $gmux/selected_port && -w $gmux/selected_port_data ]] || exit 1
echo 0x50 >"$gmux/selected_port"
printf '\001' >"$gmux/selected_port_data"
printf '\000' >"$gmux/selected_port_data"
EOF

write_file /etc/systemd/system/macbook-t1-radeon-off.service 0644 root root <<'EOF'
[Unit]
Description=Power down inactive MacBook Radeon after Intel desktop starts
After=display-manager.service
Before=sleep.target
ConditionPathExists=/sys/kernel/debug/apple_gmux/selected_port_data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/macbook-t1-radeon-off
TimeoutStartSec=75s

[Install]
WantedBy=graphical.target
EOF

systemctl disable --now macbook-t1-radeon-d3cold.service >/dev/null 2>&1 || true
rm -rf /etc/systemd/system/macbook-t1-radeon-d3cold.service.d
rm -f /etc/systemd/system/macbook-t1-radeon-d3cold.service

write_file /usr/local/sbin/macbook-t1-dri-symlinks 0755 root root <<'EOF'
#!/usr/bin/env sh
set -u
mkdir -p /dev/dri
for _ in $(seq 1 80); do
  for card in /sys/bus/pci/devices/0000:00:02.0/drm/card[0-9]*; do
    [ -e "$card" ] || continue
    node=${card##*/}
    if [ -e "/dev/dri/$node" ]; then
      ln -sfn "$node" /dev/dri/intel-igpu
      exit 0
    fi
  done
  sleep 0.25
done
exit 0
EOF

write_file /etc/systemd/system/macbook-t1-dri-symlinks.service 0644 root root <<'EOF'
[Unit]
Description=Create stable MacBookPro13,3 DRI symlinks before the display manager
DefaultDependencies=no
After=systemd-udevd.service systemd-udev-trigger.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/macbook-t1-dri-symlinks

[Install]
WantedBy=multi-user.target
EOF

