if [[ "$preserve_luks_auto_unlock" == 1 && -f /crypto_keyfile.bin ]]; then
  chmod 000 /crypto_keyfile.bin
  chown root:root /crypto_keyfile.bin
  if [[ ! -f /etc/mkinitcpio.conf.d/zz-macbook-t1-luks-keyfile.conf ]] ||
    ! grep -Fq 'FILES+=(/crypto_keyfile.bin)' /etc/mkinitcpio.conf.d/zz-macbook-t1-luks-keyfile.conf; then
    write_file /etc/mkinitcpio.conf.d/zz-macbook-t1-luks-keyfile.conf 0644 root root <<'EOF'
# Optional delegated-maintenance auto-unlock.
# /crypto_keyfile.bin is embedded into the UKI; remove this file and kill
# its LUKS keyslot to restore normal pre-boot disk-password protection.
FILES+=(/crypto_keyfile.bin)
EOF
    mark_uki_rebuild_pending "added /crypto_keyfile.bin mkinitcpio drop-in"
