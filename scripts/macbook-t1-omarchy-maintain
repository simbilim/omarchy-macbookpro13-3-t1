  printf '%s\n' "$dkms_out"
  if ! grep -q '^snd_hda_macbookpro/0[.]1,' <<<"$dkms_out"; then
    echo "WARN: snd_hda_macbookpro/0.1 is not registered in DKMS"
  fi
  if ! grep -q '^apple-ib-drv/0[.]1,' <<<"$dkms_out"; then
    echo "WARN: apple-ib-drv/0.1 is not registered in DKMS"
  fi
  if ! grep -q '^macbook-t1-ec-wake/0[.]1,' <<<"$dkms_out"; then
    echo "WARN: macbook-t1-ec-wake/0.1 is not registered in DKMS"
  fi
  if ! grep -q '^macbook-t1-socw/0[.]1,' <<<"$dkms_out"; then
    echo "WARN: macbook-t1-socw/0.1 is not registered in DKMS (Touch Bar stays dark after S3)"
  fi
  if ! grep -q '^macbook-t1-tb-nod3/0[.]1,' <<<"$dkms_out"; then
    echo "WARN: macbook-t1-tb-nod3/0.1 is not registered in DKMS (s2idle resume takes ~20 s)"
  fi
  if ! grep -q '^macbook-t1-gmux-order/0[.]1,' <<<"$dkms_out"; then
    echo "WARN: macbook-t1-gmux-order/0.1 is not registered in DKMS (panel takes ~5 s after S3)"
  fi
