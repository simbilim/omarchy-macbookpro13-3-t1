#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="/var/log/macbook-t1-omarchy-maintain.log"
mkdir -p "$(dirname "$LOG_FILE")"
exec >>"$LOG_FILE" 2>&1

echo
echo "== $(date -Is) macbook-t1-omarchy-maintain ${1:-manual} =="

if (( EUID != 0 )); then
  echo "FAIL: run as root"
  exit 1
fi

env_OMARCHY_USER="${OMARCHY_USER-}"
env_OMARCHY_ENABLE_AUTOLOGIN="${OMARCHY_ENABLE_AUTOLOGIN-}"
env_OMARCHY_ENABLE_SSH="${OMARCHY_ENABLE_SSH-}"
env_OMARCHY_ENABLE_REMOTE_MAINTENANCE="${OMARCHY_ENABLE_REMOTE_MAINTENANCE-}"
env_OMARCHY_ENABLE_LID_HIBERNATE="${OMARCHY_ENABLE_LID_HIBERNATE-}"
env_OMARCHY_ENABLE_BCM43602_5GHZ_WIFI="${OMARCHY_ENABLE_BCM43602_5GHZ_WIFI-}"
env_OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK="${OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK-}"

config_file="/etc/macbook-t1-omarchy.conf"
if [[ -f "$config_file" ]]; then
  if [[ -L "$config_file" ]]; then
    echo "FAIL: refusing symlinked config file: $config_file"
    exit 1
  fi
  config_uid="$(stat -c '%u' "$config_file")"
  config_mode="$(stat -c '%a' "$config_file")"
  if [[ "$config_uid" != 0 ]] || (( (8#$config_mode & 022) != 0 )); then
    echo "FAIL: refusing unsafe config file permissions on $config_file"
    exit 1
  fi
  while IFS='=' read -r key value; do
    case "$key" in
      ''|\#*) continue ;;
      OMARCHY_USER)
        OMARCHY_USER="$value"
        ;;
      OMARCHY_ENABLE_AUTOLOGIN|OMARCHY_ENABLE_SSH|OMARCHY_ENABLE_REMOTE_MAINTENANCE|OMARCHY_ENABLE_LID_HIBERNATE|OMARCHY_ENABLE_BCM43602_5GHZ_WIFI|OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK)
        if [[ "$value" != 0 && "$value" != 1 ]]; then
          echo "FAIL: invalid boolean in $config_file: $key=$value"
          exit 1
        fi
        printf -v "$key" '%s' "$value"
        ;;
      *)
        echo "WARN: ignoring unknown config key in $config_file: $key"
        ;;
    esac
  done <"$config_file"
fi

[[ -n "$env_OMARCHY_USER" ]] && OMARCHY_USER="$env_OMARCHY_USER"
[[ -n "$env_OMARCHY_ENABLE_AUTOLOGIN" ]] && OMARCHY_ENABLE_AUTOLOGIN="$env_OMARCHY_ENABLE_AUTOLOGIN"
[[ -n "$env_OMARCHY_ENABLE_SSH" ]] && OMARCHY_ENABLE_SSH="$env_OMARCHY_ENABLE_SSH"
[[ -n "$env_OMARCHY_ENABLE_REMOTE_MAINTENANCE" ]] && OMARCHY_ENABLE_REMOTE_MAINTENANCE="$env_OMARCHY_ENABLE_REMOTE_MAINTENANCE"
[[ -n "$env_OMARCHY_ENABLE_LID_HIBERNATE" ]] && OMARCHY_ENABLE_LID_HIBERNATE="$env_OMARCHY_ENABLE_LID_HIBERNATE"
[[ -n "$env_OMARCHY_ENABLE_BCM43602_5GHZ_WIFI" ]] && OMARCHY_ENABLE_BCM43602_5GHZ_WIFI="$env_OMARCHY_ENABLE_BCM43602_5GHZ_WIFI"
[[ -n "$env_OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK" ]] && OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK="$env_OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK"

detect_user() {
  if [[ -n "${OMARCHY_USER:-}" && "${OMARCHY_USER:-}" != root ]]; then
    printf '%s\n' "$OMARCHY_USER"
    return 0
  fi
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER:-}" != root ]]; then
    printf '%s\n' "$SUDO_USER"
    return 0
  fi
  if getent passwd 1000 >/dev/null 2>&1; then
    getent passwd 1000 | cut -d: -f1
    return 0
  fi
  return 1
}

RUN_USER="$(detect_user)" || {
  echo "FAIL: could not detect Omarchy user; set OMARCHY_USER"
  exit 1
}
RUN_GROUP="$(id -gn "$RUN_USER")"
USER_HOME="$(getent passwd "$RUN_USER" | cut -d: -f6 || true)"
if [[ -z "$USER_HOME" || ! -d "$USER_HOME" ]]; then
  echo "FAIL: invalid home for user $RUN_USER"
  exit 1
fi
if ! command -v runuser >/dev/null 2>&1; then
  echo "FAIL: runuser is required to write user configuration without root-owned home writes"
  exit 1
fi

changed_initramfs=0
state_dir="/var/lib/macbook-t1-omarchy"
pending_uki_rebuild="$state_dir/pending-uki-rebuild"
enable_autologin="${OMARCHY_ENABLE_AUTOLOGIN:-0}"
enable_ssh="${OMARCHY_ENABLE_SSH:-0}"
enable_remote_maintenance="${OMARCHY_ENABLE_REMOTE_MAINTENANCE:-0}"
enable_lid_hibernate="${OMARCHY_ENABLE_LID_HIBERNATE:-0}"
enable_bcm43602_5ghz_wifi="${OMARCHY_ENABLE_BCM43602_5GHZ_WIFI:-0}"
preserve_luks_auto_unlock="${OMARCHY_PRESERVE_LUKS_AUTO_UNLOCK:-0}"

for bool_name in enable_autologin enable_ssh enable_remote_maintenance enable_lid_hibernate enable_bcm43602_5ghz_wifi preserve_luks_auto_unlock; do
  bool_value="${!bool_name}"
  if [[ "$bool_value" != 0 && "$bool_value" != 1 ]]; then
    echo "FAIL: invalid boolean value for $bool_name: $bool_value"
    exit 1
  fi
done

if [[ "$enable_remote_maintenance" == 1 && "$enable_lid_hibernate" == 1 ]]; then
  echo "FAIL: remote maintenance conflicts with lid hibernate"
  echo "INFO: remote maintenance ignores lid/idle events; lid hibernate is for mobile safety"
  exit 1
fi

write_file() {
  local path="$1" mode="$2" owner="$3" group="$4" tmp
  write_changed=0
  tmp="$(mktemp)"
  cat >"$tmp"
  if [[ ! -f "$path" ]] || ! cmp -s "$tmp" "$path"; then
    install -D -m "$mode" -o "$owner" -g "$group" "$tmp" "$path"
    echo "updated: $path"
    write_changed=1
  fi
  rm -f "$tmp"
}

ensure_config_assignment() {
  local path="$1" key="$2" value="$3" tmp mode
  [[ -f "$path" && ! -L "$path" ]] || {
    echo "WARN: cannot manage missing or symlinked config: $path"
    return 0
  }
  tmp="$(mktemp)"
  awk -v key="$key" -v value="$value" '
    $0 ~ "^[#[:space:]]*" key "=" {
      if (!seen) print key "=" value
      seen=1
      next
    }
    { print }
    END { if (!seen) print key "=" value }
  ' "$path" >"$tmp"
  if ! cmp -s "$tmp" "$path"; then
    mode="$(stat -c '%a' "$path")"
    install -m "$mode" -o root -g root "$tmp" "$path"
    echo "updated: $path $key=$value"
  fi
  rm -f "$tmp"
}

is_root_controlled_file() {
  local path="$1" uid mode
  [[ -f "$path" && ! -L "$path" ]] || return 1
  uid="$(stat -c '%u' "$path")"
  mode="$(stat -c '%a' "$path")"
  [[ "$uid" == 0 ]] && (( (8#$mode & 022) == 0 ))
}

managed_file_matches_hash() {
  local path="$1" hash_file="$2" expected actual
  [[ -f "$path" && -f "$hash_file" ]] || return 1
  read -r expected <"$hash_file" || return 1
  actual="$(sha256sum "$path" | awk '{print $1}')"
  [[ "$actual" == "$expected" ]]
}

is_macbookpro13_3_bcm43602() {
  local model
  model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
  [[ "$model" == "MacBookPro13,3" ]] || return 1
  lspci -nn -d 14e4:43ba 2>/dev/null | grep -q 'Network controller'
}

stable_bcm43602_local_mac() {
  local model machine_id hash
  model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
  machine_id="$(cat /etc/machine-id 2>/dev/null || hostname)"
  hash="$(printf '%s:%s:%s' "$machine_id" "$model" "brcmfmac43602" | sha256sum)"
  hash="${hash%% *}"
  printf '02:%s:%s:%s:%s:%s\n' "${hash:0:2}" "${hash:2:2}" "${hash:4:2}" "${hash:6:2}" "${hash:8:2}"
}

validate_bcm43602_nvram() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  grep -Eq '^devid=0x43ba$' "$path" &&
    grep -Eq '^ccode=00$' "$path" &&
    grep -Eq '^regrev=245$' "$path" &&
    grep -Eq '^aa5g=7$' "$path" &&
    grep -Eq '^txchain=7$' "$path" &&
    grep -Eq '^rxchain=7$' "$path" &&
    grep -Eq '^macaddr=([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$' "$path"
}

ensure_bcm43602_5ghz_wifi() {
  local source="/usr/local/share/macbook-t1-omarchy/brcmfmac43602-pcie-source.txt"
  local dest_dir="/usr/lib/firmware/updates/brcm"
  local generic_dest="$dest_dir/brcmfmac43602-pcie.txt"
  local dmi_dest="$dest_dir/brcmfmac43602-pcie.Apple Inc.-MacBookPro13,3.txt"
  local nm_conf="/etc/NetworkManager/conf.d/90-macbook-t1-brcmfmac.conf"
  local hash_file="$state_dir/brcmfmac43602-5ghz.sha256"
  local mac tmp hash

  if [[ "$enable_bcm43602_5ghz_wifi" != 1 ]]; then
    if [[ -f "$hash_file" ]]; then
      for path in "$generic_dest" "$dmi_dest"; do
        if managed_file_matches_hash "$path" "$hash_file"; then
          rm -f -- "$path"
          echo "removed: $path"
        fi
      done
      rm -f -- "$hash_file"
    fi
    if [[ -f "$nm_conf" ]] && grep -Fqx '# Managed by macbook-t1-omarchy' "$nm_conf"; then
      rm -f -- "$nm_conf"
      echo "removed: $nm_conf"
    fi
    return 0
  fi

  if ! is_macbookpro13_3_bcm43602; then
    echo "FAIL: BCM43602 5 GHz Wi-Fi override is only enabled for MacBookPro13,3 with PCI 14e4:43ba"
    exit 1
  fi

  if ! is_root_controlled_file "$source"; then
    echo "FAIL: missing or unsafe BCM43602 NVRAM source: $source"
    echo "INFO: install it with ./install.sh --enable-bcm43602-5ghz-wifi --bcm43602-nvram-file FILE"
    exit 1
  fi

  tmp="$(mktemp)"
  mac="$(stable_bcm43602_local_mac)"
  awk -v mac="$mac" '
    { sub(/\r$/, "") }
    /^macaddr=/ { print "macaddr=" mac; seen=1; next }
    { print }
    END { if (!seen) print "macaddr=" mac }
  ' "$source" >"$tmp"

  if ! validate_bcm43602_nvram "$tmp"; then
    rm -f "$tmp"
    echo "FAIL: BCM43602 NVRAM source did not produce a valid managed override"
    exit 1
  fi

  install -d -m 0755 -o root -g root "$dest_dir" "$state_dir"
  for path in "$generic_dest" "$dmi_dest"; do
    if [[ ! -f "$path" ]] || ! cmp -s "$tmp" "$path"; then
      install -D -m 0644 -o root -g root "$tmp" "$path"
      echo "updated: $path"
    fi
  done
  hash="$(sha256sum "$tmp" | awk '{print $1}')"
  printf '%s\n' "$hash" >"$hash_file"
  chmod 0644 "$hash_file"
  rm -f "$tmp"

  write_file "$nm_conf" 0644 root root <<'EOF'
# Managed by macbook-t1-omarchy
[device-macbook-t1-bcm43602]
match-device=interface-name:=wlp3s0,driver:brcmfmac
wifi.scan-rand-mac-address=no

[connection-macbook-t1-bcm43602]
match-device=interface-name:=wlp3s0,driver:brcmfmac
wifi.cloned-mac-address=permanent
EOF
}

mark_uki_rebuild_pending() {
  local reason="$1"
  install -d -m 0755 -o root -g root "$state_dir"
  printf '%s\n' "$reason" >"$pending_uki_rebuild"
  changed_initramfs=1
}

is_managed_or_legacy_autologin() {
  local path="/etc/sddm.conf.d/autologin.conf" tmp result
  [[ -f "$path" ]] || return 1
  if grep -Fqx '# Managed by macbook-t1-omarchy' "$path"; then
    return 0
  fi
  tmp="$(mktemp)"
  {
    printf '%s\n' '[Autologin]'
    printf 'User=%s\n' "$RUN_USER"
    printf '%s\n' 'Session=omarchy.desktop'
  } >"$tmp"
  cmp -s "$tmp" "$path"
  result=$?
  rm -f "$tmp"
  return "$result"
}

run_as_desktop_user() {
  runuser -u "$RUN_USER" -- env USER_HOME="$USER_HOME" bash -s
}

ensure_hypr_key_latency_guard() {
  run_as_desktop_user <<'EOF'
set -euo pipefail
path="$USER_HOME/.config/hypr/looknfeel.lua"
[[ -f "$path" && ! -L "$path" ]] || {
  echo "WARN: cannot apply keyboard latency guard to missing or symlinked file: $path"
  exit 0
}
if grep -Fq 'local focus_border_is_visible = nil' "$path"; then
  exit 0
fi
if ! grep -Fq 'hl.on("input.keyboard.key", handle_keyboard_input)' "$path"; then
  echo "INFO: Omarchy looknfeel no longer has the per-key focus-border callback"
  exit 0
fi
python3 - "$path" <<'PY'
import os
from pathlib import Path
import shutil
import sys
import tempfile

path = Path(sys.argv[1])
old = """local function set_focus_border_visible(visible)
  hl.config({"""
new = """local focus_border_is_visible = nil

local function set_focus_border_visible(visible)
  if focus_border_is_visible == visible then
    return
  end
  focus_border_is_visible = visible

  hl.config({"""
text = path.read_text()
if text.count(old) != 1:
    print(f"WARN: unexpected focus-border callback in {path}; latency guard not applied")
    raise SystemExit(0)
updated = text.replace(old, new, 1)
backup = path.with_name(path.name + ".before-key-latency-guard")
if not backup.exists():
    shutil.copy2(path, backup)
fd, temporary = tempfile.mkstemp(prefix=".looknfeel-latency-", dir=path.parent)
try:
    with os.fdopen(fd, "w") as stream:
        stream.write(updated)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, path.stat().st_mode & 0o777)
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
print(f"updated: {path} keyboard focus-border latency guard")
PY
EOF
}

is_known_legacy_artifact() {
  local path="$1" pattern
  [[ -f "$path" && ! -L "$path" ]] || return 1
  case "$path" in
    /etc/systemd/system/codex-limine-unattended-fix.path|\
    /etc/systemd/system/codex-limine-unattended-fix.service|\
    /etc/boot/hooks/post.d/80-codex-macbook-rescue-defaults|\
    /usr/local/sbin/codex-limine-unattended-fix)
      pattern='codex-limine|limine|/boot/limine\.conf|Limine'
      ;;
    /etc/systemd/system/codex-dri-symlinks.service|\
    /usr/local/sbin/codex-dri-symlinks)
      pattern='codex-dri|dri|radeon-dgpu|intel-igpu|MacBookPro13,3'
      ;;
    /etc/systemd/system/omarchy-nvme-suspend-fix.service)
      pattern='omarchy-nvme-suspend-fix|nvme|suspend|power/control'
      ;;
    /etc/systemd/system/codex-graphics-failsafe.service|\
    /etc/systemd/system/codex-graphics-failsafe.timer|\
    /usr/local/sbin/codex-graphics-failsafe)
      pattern='codex-graphics-failsafe|graphics|failsafe|Hyprland|AQ_NO_MODIFIERS'
      ;;
    /etc/systemd/system/sddm.service.d/20-macbook-dri-ordering.conf)
      pattern='macbook|MacBookPro13,3|dri|radeon|intel|rtkit'
      ;;
    /etc/systemd/logind.conf.d/99-codex-remote-maintenance.conf)
      pattern='HandleLidSwitch=ignore|IdleAction=ignore|remote-maintenance|codex'
      ;;
    /etc/systemd/logind.conf.d/90-macbookpro13-3-lid-lock.conf)
      pattern='HandleLidSwitch=lock|MacBookPro13,3|macbookpro13-3'
      ;;
    /etc/pacman.d/hooks/99-codex-macbook-t1-maintain.hook)
      pattern='codex|macbook-t1|omarchy|pacman-hook'
      ;;
    /usr/local/sbin/codex-macbook-t1-maintain)
      pattern='codex|macbook-t1|MacBookPro13,3|omarchy|limine|dri'
      ;;
    *)
      return 1
      ;;
  esac

  LC_ALL=C grep -Eaq "$pattern" "$path"
}

disable_known_legacy_unit() {
  local unit="$1" fragment
  fragment="$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null || true)"
  [[ -n "$fragment" ]] || return 0
  if is_known_legacy_artifact "$fragment"; then
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
  else
    echo "WARN: preserving unknown legacy unit content: $fragment"
  fi
}

remove_known_legacy_path() {
  local path="$1"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ -L "$path" ]]; then
    echo "WARN: preserving symlinked legacy path: $path"
    return 0
  fi
  if is_known_legacy_artifact "$path"; then
    rm -f -- "$path"
    echo "removed legacy: $path"
  else
    echo "WARN: preserving unknown legacy path content: $path"
  fi
}

cleanup_legacy_artifacts() {
  local unit path

  for unit in \
    codex-limine-unattended-fix.path \
    codex-dri-symlinks.service \
    omarchy-nvme-suspend-fix.service \
    codex-graphics-failsafe.timer; do
    disable_known_legacy_unit "$unit"
  done

  for path in \
    /etc/systemd/system/codex-limine-unattended-fix.path \
    /etc/systemd/system/codex-limine-unattended-fix.service \
    /etc/systemd/system/codex-dri-symlinks.service \
    /etc/systemd/system/omarchy-nvme-suspend-fix.service \
    /etc/systemd/system/codex-graphics-failsafe.service \
    /etc/systemd/system/codex-graphics-failsafe.timer \
    /etc/systemd/system/sddm.service.d/20-macbook-dri-ordering.conf \
    /etc/systemd/logind.conf.d/99-codex-remote-maintenance.conf \
    /etc/systemd/logind.conf.d/90-macbookpro13-3-lid-lock.conf \
    /etc/boot/hooks/post.d/80-codex-macbook-rescue-defaults \
    /etc/pacman.d/hooks/99-codex-macbook-t1-maintain.hook \
    /usr/local/sbin/codex-macbook-t1-maintain \
    /usr/local/sbin/codex-limine-unattended-fix \
    /usr/local/sbin/codex-dri-symlinks \
    /usr/local/sbin/codex-graphics-failsafe; do
    remove_known_legacy_path "$path"
  done

  run_as_desktop_user <<'EOF'
set -euo pipefail

path="$USER_HOME/.config/omarchy/hooks/post-update.d/codex-macbook-t1-post-update"
if [[ -e "$path" || -L "$path" ]]; then
  if [[ -L "$path" ]]; then
    echo "WARN: preserving symlinked legacy path: $path"
  elif LC_ALL=C grep -Eaq 'codex|macbook-t1|MacBookPro13,3|omarchy-maintain' "$path"; then
    rm -f -- "$path"
    echo "removed legacy: $path"
  else
    echo "WARN: preserving unknown legacy path content: $path"
  fi
fi
EOF
}

disable_omarchy_stay_awake() {
  run_as_desktop_user <<'EOF'
set -euo pipefail

path="$USER_HOME/.local/state/omarchy/indicators/stay-awake"
if [[ -e "$path" || -L "$path" ]]; then
  rm -f -- "$path"
  echo "removed mobile-unsafe stay-awake marker: $path"
fi
EOF
}

ensure_hypr_graphics_block() {
  run_as_desktop_user <<'EOF'
set -euo pipefail

path="$USER_HOME/.config/hypr/hyprland.lua"
install -d -m 0755 "$(dirname "$path")"
if [[ -L "$path" ]]; then
  echo "WARN: refusing symlinked Hyprland config: $path"
  exit 0
fi
  touch "$path"
  chmod 0644 "$path"
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  awk '
    $0 == "-- BEGIN MacBookPro13,3 T1 graphics" { skip=1; next }
    $0 == "-- END MacBookPro13,3 T1 graphics" { skip=0; next }
    $0 == "-- BEGIN Codex MacBookPro13,3 T1 graphics" { skip=1; next }
    $0 == "-- END Codex MacBookPro13,3 T1 graphics" { skip=0; next }
    skip { next }
    $0 == "-- Internal panel is wired to the Radeon GPU; avoid Intel/no-output scanout." { next }
    $0 == "-- EFI routes the internal panel to Intel; keep the compositor off the Radeon." { next }
    $0 == "hl.env(\"AQ_DRM_DEVICES\", \"/dev/dri/radeon-dgpu\")" { next }
    $0 == "hl.env(\"AQ_DRM_DEVICES\", \"/dev/dri/intel-igpu\")" { next }
    $0 == "-- Avoid modifier paths that can leave the internal eDP panel black on Aquamarine/AMDGPU." { next }
    $0 == "hl.env(\"AQ_NO_MODIFIERS\", \"1\")" { next }
    $0 == "hl.env(\"HYPRLAND_EGL_NO_MODIFIERS\", \"1\")" { next }
    { print }
  ' "$path" >"$tmp"
  perl -0pi -e 's/\n+\z/\n/' "$tmp"
  {
    printf '%s\n' '-- BEGIN MacBookPro13,3 T1 graphics'
    printf '%s\n' '-- EFI routes the internal panel to Intel; keep the compositor off the Radeon.'
    printf '%s\n' 'hl.env("AQ_DRM_DEVICES", "/dev/dri/intel-igpu")'
    printf '%s\n' '-- Avoid modifier paths that can leave the internal eDP panel black on Aquamarine/AMDGPU.'
    printf '%s\n' 'hl.env("AQ_NO_MODIFIERS", "1")'
    printf '%s\n' 'hl.env("HYPRLAND_EGL_NO_MODIFIERS", "1")'
    printf '%s\n' '-- END MacBookPro13,3 T1 graphics'
  } >>"$tmp"
  if ! cmp -s "$tmp" "$path"; then
    cp "$tmp" "$path"
    echo "updated: $path MacBookPro13,3 graphics block"
  fi
  chmod 0644 "$path"
EOF
}

ensure_hypr_trackpad_block() {
  run_as_desktop_user <<'EOF'
set -euo pipefail

path="$USER_HOME/.config/hypr/input.lua"
install -d -m 0755 "$(dirname "$path")"
if [[ -L "$path" ]]; then
  echo "WARN: refusing symlinked Hyprland input config: $path"
  exit 0
fi
touch "$path"
chmod 0644 "$path"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
awk '
  $0 == "-- BEGIN MacBookPro13,3 T1 trackpad" { skip=1; next }
  $0 == "-- END MacBookPro13,3 T1 trackpad" { skip=0; next }
  skip { next }
  { print }
' "$path" >"$tmp"
perl -0pi -e 's/\n+\z/\n/' "$tmp"
cat >>"$tmp" <<'LUA'
-- BEGIN MacBookPro13,3 T1 trackpad
-- Keep palm contact from grabbing and dragging windows while typing.
hl.config({
  input = {
    touchpad = {
      disable_while_typing = true,
      tap_and_drag = false,
    },
  },
})
-- END MacBookPro13,3 T1 trackpad
LUA
if ! cmp -s "$tmp" "$path"; then
  cp "$tmp" "$path"
  echo "updated: $path MacBookPro13,3 trackpad block"
fi
chmod 0644 "$path"
EOF
}

ensure_hypr_brightness_block() {
  run_as_desktop_user <<'EOF'
set -euo pipefail

path="$USER_HOME/.config/hypr/bindings.lua"
script=/usr/local/bin/macbook-t1-brightness-control
[[ -f "$path" && ! -L "$path" ]] || {
  echo "WARN: cannot manage brightness keys in missing or symlinked file: $path"
  exit 0
}
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
awk '
  $0 == "-- BEGIN MacBookPro13,3 T1 brightness" { skip=1; next }
  $0 == "-- END MacBookPro13,3 T1 brightness" { skip=0; next }
  skip { next }
  { print }
' "$path" >"$tmp"
perl -0pi -e 's/\n+\z/\n/' "$tmp"
# The script delegates to these Omarchy commands. If an update removed one,
# drop the block so the keys fall back to Omarchy's own bindings.
missing=""
for cmd in omarchy-brightness-display omarchy-hw-display omarchy-shell brightnessctl jq; do
  command -v "$cmd" >/dev/null || missing+=" $cmd"
done
[[ -x $script ]] || missing+=" $script"
if [[ -n $missing ]]; then
  echo "WARN: brightness keys left at Omarchy defaults; missing:$missing"
else
  cat >>"$tmp" <<'LUA'
-- BEGIN MacBookPro13,3 T1 brightness
-- Omarchy brightness steps from 1% up, plus 0.8, 0.6, 0.4 and 0.2% below 1%.
-- Shift+brightness keys keep Omarchy's minimum/maximum bindings.
hl.unbind("XF86MonBrightnessUp")
hl.unbind("XF86MonBrightnessDown")
o.bind("XF86MonBrightnessUp", "Brightness up (fine below 1%)", "/usr/local/bin/macbook-t1-brightness-control up", { locked = true, repeating = true })
o.bind("XF86MonBrightnessDown", "Brightness down (fine below 1%)", "/usr/local/bin/macbook-t1-brightness-control down", { locked = true, repeating = true })
-- END MacBookPro13,3 T1 brightness
LUA
fi
if ! cmp -s "$tmp" "$path"; then
  cp "$tmp" "$path"
  echo "updated: $path MacBookPro13,3 brightness block"
fi
EOF
}

ensure_omarchy_post_update_hook() {
  run_as_desktop_user <<'EOF'
set -euo pipefail

path="$USER_HOME/.config/omarchy/hooks/post-update.d/macbook-t1-omarchy-maintain"
install -d -m 0755 "$(dirname "$path")"
if [[ -L "$path" ]]; then
  echo "WARN: refusing symlinked Omarchy post-update hook: $path"
  exit 0
fi
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<'HOOK'
#!/usr/bin/env bash
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/macbook-t1-omarchy"
mkdir -p "$state_dir"
log_file="$state_dir/macbook-t1-omarchy-post-update.log"

{
  echo "== $(date -Is) post-update guard =="
  if command -v sudo >/dev/null 2>&1; then
    sudo /usr/local/sbin/macbook-t1-omarchy-maintain post-update
  else
    echo "FAIL: sudo missing"
    exit 1
  fi
} >>"$log_file" 2>&1
HOOK
chmod 0755 "$tmp"
if [[ ! -f "$path" ]] || ! cmp -s "$tmp" "$path"; then
  cp "$tmp" "$path"
  chmod 0755 "$path"
  echo "updated: $path"
fi
EOF
}

cleanup_legacy_artifacts

# Keep the recovery menu useful without presenting every historical snapshot.
# The ordinary Arch kernel was removed; exclude its stale snapshot entries.
ensure_config_assignment /etc/limine-snapper-sync.conf MAX_SNAPSHOT_ENTRIES 2
ensure_config_assignment /etc/limine-snapper-sync.conf EXCLUDE_SNAPSHOT_ENTRIES '"linux, linux-omarchy"'

write_file /usr/local/sbin/macbook-t1-limine-unattended-fix 0755 root root <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
conf="${LIMINE_CONF:-/boot/limine.conf}"
timeout="${LIMINE_TIMEOUT:-1}"
default_entry="${LIMINE_DEFAULT_ENTRY:-1}"
strip_path_hashes="${LIMINE_STRIP_PATH_HASHES:-0}"
[[ -f "$conf" ]] || exit 0
[[ "$timeout" =~ ^[0-9]+$ ]] || exit 2
[[ "$default_entry" =~ ^[0-9]+$ ]] || exit 2
[[ "$strip_path_hashes" =~ ^[01]$ ]] || exit 2
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
TIMEOUT="$timeout" DEFAULT_ENTRY="$default_entry" STRIP_PATH_HASHES="$strip_path_hashes" perl -0pe '
  if ($ENV{STRIP_PATH_HASHES} eq "1") {
    s{(^[ \t]*path:[ \t]*boot\(\):/[^#\n]*)#[0-9a-fA-F]{128}}{$1}mg;
  }
  s{^timeout:\s*.*$}{"timeout: " . $ENV{TIMEOUT}}emg;
  s{^default_entry:\s*.*$}{"default_entry: " . $ENV{DEFAULT_ENTRY}}emg;
' "$conf" >"$tmp"
if ! cmp -s "$tmp" "$conf"; then
  cp "$conf" "$conf.before-macbook-t1-unattended-$(date +%Y%m%d-%H%M%S)" || true
  cp "$tmp" "$conf"
  echo "updated: $conf"
fi
EOF

write_file /etc/boot/hooks/post.d/80-macbook-t1-rescue-defaults 0755 root root <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
/usr/local/sbin/macbook-t1-limine-unattended-fix
EOF

