      rm -f "$keyfile_dropin"
      mark_uki_rebuild_pending "removed $keyfile_dropin"
      echo "removed: $keyfile_dropin"
    fi
  done
  echo "INFO: LUKS auto-unlock is not enabled or preserved by default"
fi

